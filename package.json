{
  "name": "@aurodesignsystem/auro-config",
  "version": "0.0.0",
  "description": "This package contains the shared configuration for the development tools used by Auro.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlaskaAirlines/auro-config"
  },
  "keywords": [
    "alaska airlines",
    "auro",
    "design system",
    "configs"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./biome": "./configs/biome.json",
    "./stylelint": "./configs/stylelint.json",
    "./releaserc": "./configs/releaserc.json",
    "./commitlint": "./configs/commitlint.js",
    "./lintstaged": "./configs/lintstaged.json"
  },
  "files": [
    "configs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "lint": "biome check --no-errors-on-unmatched",
    "lint:fix": "biome check --fix --no-errors-on-unmatched",
    "prepare": "husky",
    "test": "node --test"
  },
  "dependencies": {
    "@biomejs/biome": "2.3.2",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "lint-staged": "^16.2.6",
    "semantic-release": "^25.0.1",
    "stylelint": "^16.18.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.8.1"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
